{
  "name": "beat-the-hazard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Beat The Hazard - 3D interactive health & safety training game for warehouse forklift and pedestrian safety.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:single": "vite build --config vite.single.config.js && node scripts/build-singlefile.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
